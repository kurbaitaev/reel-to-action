# Copy to .env and fill in. Run `python3 doctor.py` to check what's still missing.
# ─── Required ────────────────────────────────────────────────────────────────

# Get a token from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id — send /start to your bot and it tells you,
# or ask @userinfobot. Comma-separated for several people.
# The bot REFUSES EVERYONE until this is set: an open bot means anyone who
# finds the token can run processes on your machine.
ALLOWED_USER_IDS=

# Reasoning backend — pick ONE. An API key is required to run on a server:
# the Claude Code CLI logs in through a browser, which can't work headless.
#
#   a) OPENAI_API_KEY      → OpenAI Responses API. Works anywhere, never
#                            expires. ~$0.15-0.25 per reel (the built-in web
#                            search is billed at $0.01 per search).
#   b) ANTHROPIC_API_KEY   → same, via the Claude CLI. Never expires.
#   c) nothing set         → the Claude CLI on your own login (`claude`,
#                            then /login). Free with a subscription, but the
#                            login expires every few months and the bot stops.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# ANTHROPIC_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Model for the reasoning agent (this bot only; overrides your global default).
# A stronger model gets links right more often. Unset = your Claude default.
CLAUDE_MODEL=claude-sonnet-4-6

# PAID, and worth it if you watch talking-head reels: Apify adds the SPOKEN
# TRANSCRIPT and is more reliable than yt-dlp. Token from console.apify.com
# (Settings → Integrations → API tokens).
# Without it everything still works — notes are built from the caption and the
# text shown on screen, and the note says the audio wasn't available.
APIFY_TOKEN=
# The token also enables X/Twitter links (text, photo and video posts).
# Advanced: override only if you want different actors.
# APIFY_TRANSCRIBER_ACTOR=apple_yang~instagram-transcripts-scraper
# APIFY_SCRAPER_ACTOR=apify~instagram-scraper
# APIFY_TWEET_ACTOR=apidojo~tweet-scraper

# Notion sync: internal integration token (notion.so/my-integrations) + the
# database id you shared with it. Unset = skipped; the local vault still works.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# How many frames to sample per video so the agent can read on-screen text
# (book covers, lists, handles). 0 disables it. Reels with thin speech get more.
VIDEO_FRAMES=6

# Telegram Rich Messages (native headings/lists). Set 0 for plain HTML.
RICH_MESSAGE=1

# launchd service name. Default: com.<your-username>.reel-to-action
# SERVICE_LABEL=

# Only used if you run the optional gemini-analyze MCP for video transcription.
GEMINI_API_KEY=
