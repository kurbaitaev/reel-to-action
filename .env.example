# Get a token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id — the bot tells you it on /start,
# or ask @userinfobot. Comma-separated if several. LEAVE THIS SET:
# without it anyone who finds the bot can use your machine.
ALLOWED_USER_IDS=

# Apify API token (Settings → Integrations → API tokens at console.apify.com).
# Instagram links use two actors: a transcriber (reel URL → transcript) and a
# scraper (→ caption/author). Without a token, IG falls back to yt-dlp + Gemini.
APIFY_TOKEN=
# Advanced: override only if you want different actors.
# APIFY_TRANSCRIBER_ACTOR=apple_yang~instagram-transcripts-scraper
# APIFY_SCRAPER_ACTOR=apify~instagram-scraper

# Optional: used as fallback for transcription if the gemini-analyze
# MCP isn't available in headless runs
GEMINI_API_KEY=

# Model for the reasoning agent (overrides your global Claude default, this bot only).
# Sonnet = fast + high quality; claude-haiku-4-5 = fastest; unset = your default.
CLAUDE_MODEL=claude-sonnet-4-6

# Notion: internal integration token (notion.so/my-integrations) + the database
# ID it's been shared with. If unset, the bot skips Notion (Obsidian still works).
NOTION_TOKEN=
NOTION_DATABASE_ID=
